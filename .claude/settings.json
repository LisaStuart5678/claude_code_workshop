{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Search",
        "hooks": [
          {
            "type": "command",
            "command": "graphify route {tool_input}"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm test -- --passWithNoTests"
          }
        ]
      }
    ]
  }
}
